# MySQL 配置
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=ctf_user
MYSQL_PASSWORD=change_this_password
MYSQL_DATABASE=ctf_db

# MySQL Root 密码（仅在你自行部署独立 MySQL 时使用，可选）
MYSQL_ROOT_PASSWORD=change_this_password

# Redis URI：redis://[:密码]@主机:端口/库编号
REDIS_ADDR=redis://:change_this_password@redis:6379/2

# 后端配置
SECRET_KEY=change_this_to_a_very_long_random_string_at_least_32_characters
FIRST_SUPERUSER_PASSWORD=replace_with_a_strong_password

# 服务器配置
SERVER_HOST=http://localhost

# Flag 配置
FLAG_PREFIX=flag{
FLAG_SUFFIX=}
FLAG_LENGTH=16

# 模板仓库配置
TEMPLATES_REPOSITORY_URL=https://github.com/hexbay/ctfdb.git
TEMPLATES_REPOSITORY_BRANCH=main
TEMPLATES_REPOSITORY_PATH=templates/ctf_db

# 统一网络代理（Git 资源仓库同步和在线更新，可选）
# 支持 HTTP 和 SOCKS5
# PROXY=http://127.0.0.1:10808
# PROXY=socks5://127.0.0.1:10808

# AI 配置（可选）
AI_ENABLED=false
# AI_API_KEY=your_api_key_here
# AI_API_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-3.5-turbo
# AI_TEMPERATURE=0.3
# AI_MAX_TOKENS=200

# SMTP 邮件配置（可选）
# SMTP_TLS=true
# SMTP_PORT=587
# SMTP_HOST=smtp.example.com
# SMTP_USER=your_email@example.com
# SMTP_PASSWORD=your_email_password
# EMAILS_FROM_EMAIL=noreply@example.com
# EMAILS_FROM_NAME=CloudCTF

# CORS 配置（可选）
# BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# 项目名称（可选）
# PROJECT_NAME=CloudCTF
