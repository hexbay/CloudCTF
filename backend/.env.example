# 复制为 data/.env 后生效；也可通过 CONFIG_FILE 指定其他路径。
# 真实环境变量优先级高于本文件。
#
# 开发环境默认管理员（首次启动自动创建）：
#   用户名：admin
#   密码：admin123456
# 默认选手（首次启动自动创建）：
#   用户名：player1
#   密码：password123
# 生产环境未设置 FIRST_SUPERUSER_PASSWORD 时会自动生成，值保存在 data/.env。
APP_NAME=CloudCTF API
APP_ENV=development
HOST=0.0.0.0
PORT=8005
LOG_LEVEL=info
LOG_FILE=logs/backend.log
# SQLite（默认）：sqlite://data/cloudctf.db
# MySQL：mysql://cloudctf:password@tcp(localhost:3306)/cloudctf?charset=utf8mb4&parseTime=True&loc=Local
# PostgreSQL：postgres://cloudctf:password@localhost:5432/cloudctf?sslmode=disable
DATABASE_URI=sqlite://data/cloudctf.db
REDIS_ADDR=localhost:6379
# JWT_SECRET 留空时，生产环境首次启动会自动生成并持久化。
JWT_SECRET=
UPLOAD_DIR=static/uploads
STATIC_DIR=static
FRONTEND_DIR=../frontend/dist
BACKUP_DIR=data/backups
BACKUP_RETENTION=7
# 同源访问不需要设置；跨域时再填写允许的来源。
# ALLOWED_ORIGINS=https://ctf.example.com

# 在线更新（读取 GitHub 最新 Release，对应 v* Tag）
UPDATE_ENABLED=true
UPDATE_REPOSITORY=hexbay/CloudCTF
UPDATE_API_URL=https://api.github.com
# 公共仓库通常无需 Token；配置后可提高 GitHub API 限额。
# UPDATE_GITHUB_TOKEN=github_pat_xxx
