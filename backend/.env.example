# 复制为 .env 后生效；也可通过 CONFIG_FILE 指定其他路径。
# 真实环境变量优先级高于本文件。
#
# 默认管理员（首次启动自动创建）：
#   用户名：admin
#   密码：admin123456
# 默认选手（首次启动自动创建）：
#   用户名：player1
#   密码：password123
# ⚠️ 部署到生产环境后请立即修改密码。
APP_NAME=CloudCTF API
APP_ENV=development
HOST=0.0.0.0
PORT=8005
LOG_LEVEL=info
LOG_FILE=logs/backend.log
# SQLite（默认）：sqlite://data/cloudctf.db
# MySQL：mysql://root:root@tcp(localhost:3306)/cloudctf
DATABASE_URI=sqlite://data/cloudctf.db
REDIS_ADDR=localhost:6379
JWT_SECRET=change-me
UPLOAD_DIR=static/uploads
STATIC_DIR=static
FRONTEND_DIR=../frontend/dist
BACKUP_DIR=data/backups
BACKUP_RETENTION=7
# 开发环境可使用 *；APP_ENV=production 时必须改为实际访问源。
# 示例：ALLOWED_ORIGINS=https://ctf.example.com,http://127.0.0.1:8005
ALLOWED_ORIGINS=*

# 在线更新（读取 GitHub 最新 Release，对应 v* Tag）
UPDATE_ENABLED=true
UPDATE_REPOSITORY=hexbay/CloudCTF
UPDATE_API_URL=https://api.github.com
# 公共仓库通常无需 Token；配置后可提高 GitHub API 限额。
# UPDATE_GITHUB_TOKEN=github_pat_xxx
